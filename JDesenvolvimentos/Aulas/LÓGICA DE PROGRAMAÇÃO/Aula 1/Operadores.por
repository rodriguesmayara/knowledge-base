programa
{    //operadores
     // atribuição (=) 
     // comparação (==)
     //aritméticos => operações aritméticas
     real valor_1=2.0, valor_2=3.0
     inteiro bala_1=4, bala_2=4
     inteiro valor_analisado=29
     //lógicos => valores lógicos [verdadeiro/falso]
     //condicionais => analisam condições e desviam o fluxo do código
	funcao inicio()
	{
		//Operadores aritmétricos
		escreva(valor_1 + valor_2) // adição
		escreva("\n")
		escreva(valor_1 - valor_2) // subritração
		escreva("\n")
		escreva(valor_1 * valor_2) // multiplicação
		escreva("\n")
		escreva(valor_1 / valor_2) // divisão
		escreva("\n")
		escreva((bala_1 + bala_2) % 2) // resto de divisão
		escreva("\n")
		escreva(valor_analisado % 2 == 0) // adição
		escreva("\n")
	}
}
