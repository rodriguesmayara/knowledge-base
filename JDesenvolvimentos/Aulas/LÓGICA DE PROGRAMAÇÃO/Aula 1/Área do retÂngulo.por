programa
{
     real altura, base 
     
	funcao inicio()
	{
	     
	     escreva("Vamos calcular a área de um retângulo? Siga os passos a baixo\n")
		escreva("Informe o valor da altura do retângulo: ")
		leia(altura) 
		
		escreva("Informe o valor da base do retângulo: ")
		leia(base)

          // processo e saída
		escreva( "A área do retÂngulo é: " + altura*base)
	}
}
